# DB_CONNECTION

# Local development (without Docker): point to your local postgres
DATABASE_URL=postgres://rag:rag@localhost:5432/ragdb

# Inside docker-compose the app uses: postgres://rag:rag@db:5432/ragdb

# VISION / OCR (Ollama - modelos multimodales)
# - En desarrollo local, Ollama corre en tu máquina:
OLLAMA_HOST=http://localhost:11434
# - Dentro de docker-compose, la app alcanza el Ollama del host:
#   OLLAMA_HOST=http://host.docker.internal:11434

# Modelo recomendado (computadora con buena GPU): qwen3-vl:32b  (requiere Ollama 0.12.7 o superior)
# Alternativas: qwen3-vl:8b / qwen3-vl:30b, qwen2.5vl:32b, glm-ocr (OCR especializado en documentos)
OLLAMA_MODEL=qwen3-vl:8b